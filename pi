#!/usr/bin/env bash
# Run Pi coding agent in Docker
# Place a .env file next to this script with your API keys, e.g.:
#   ANTHROPIC_API_KEY=sk-ant-...
#   OPENAI_API_KEY=sk-...

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env"
PI_CONFIG="$HOME/.pi"

# Create pi config tracking layout if it doesn't exist
mkdir -p "$PI_CONFIG/agent"

# Dynamically link the Scratch server configuration into your local Mac mount path
# Update this specific block inside your local bash script:
if [ ! -f "$PI_CONFIG/agent/mcp.json" ]; then
  echo "Injecting clean Scratch Python MCP configuration template..."
  echo '{
  "mcpServers": {
    "scratch": {
      "command": "/opt/scratch-mcp/.venv/bin/python",
      "args": ["-m", "scratch_mcp"],
      "cwd": "/opt/scratch-mcp",
      "env": {
        "PYTHONPATH": "/opt/scratch-mcp"
      },
      "timeout": 600000
    }
  }
}' > "$PI_CONFIG/agent/mcp.json"
fi


# Ensure output repository for games exists locally
mkdir -p "$SCRIPT_DIR/scratch-projects"

# Run container with port mapping enabled for TurboWarp web link previews
docker run -it --rm \
  --env-file "$ENV_FILE" \
  -v "$(pwd):/pi-workspace" \
  -v "$PI_CONFIG:/root/.pi" \
  -p 3000:3000 \
  -w /pi-workspace \
  ghcr.io/agent-friday-claw/pi-docker:latest
